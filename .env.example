# Copy to .env.local and fill in real values. Never commit .env.local.

# Public - safe to expose to the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://jbmakvbmyddvlgfjonmc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY - never prefix with NEXT_PUBLIC_, never expose to the browser.
# Supabase dashboard -> Project Settings -> API -> service_role key.
# Used only by app/api/payments/** route handlers to act on behalf of
# customers (who have no account) for the EcoCash proof-of-payment flow:
# creating and reading payment status, validating and storing uploads.
# Bypasses Row Level Security entirely - treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Sign up free at resend.com, create an API key. Used by
# app/api/send-document to email receipts/invoices/quotations as PDF
# attachments. Without it, email sending is skipped gracefully (buttons
# show "email isn't configured" rather than failing the whole action).
RESEND_API_KEY=

# Must be on a domain verified with Resend (Resend dashboard -> Domains).
# Until a real domain is verified, Resend's own onboarding@resend.dev
# sender works but can only deliver to the Resend account's own email -
# fine for testing, not for real guests.
RESEND_FROM_EMAIL=Damview Resort <onboarding@resend.dev>
